# Local configuration only. Fill these with your separate local database URLs.
DATABASE_URL=
# Neon CLI writes this direct connection for migrations.
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=
APP_ORIGIN=http://localhost:5174
SECURE_COOKIES=0
LOCAL_TEST_CONTROLS=0
# Optional shared gate for local verification; never commit real credentials.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Keep basic mode until Google is registered; production google mode requires both.
AUTH_MODE=basic
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
