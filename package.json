{
  "name": "passing-notes",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "client": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.js",
    "test:db": "vitest run tests/postgres.test.js tests/migrations.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"tests/**/*.js\" \"scripts/*.{js,mjs}\" vite*.config.js package.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"tests/**/*.js\" \"scripts/*.{js,mjs}\" vite*.config.js package.json",
    "hosting:configure": "node scripts/configure-hosting.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.0",
    "luxon": "^3.7.2",
    "pg": "8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "supertest": "^7.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "24.x"
  }
}
